{
  "name": "po-bus-27-trans-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:server:dev\" \"npm:web:dev\"",
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "server:dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "web": "vite",
    "web:dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "seed:reset": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "smoke": "node --disable-warning=ExperimentalWarning server/smoke-test.js",
    "lint": "eslint server src packages/ui/src"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^13.4.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
